{
  "_readme": "Reference data for Urdu property speech. The LLM handles most of this from the system prompt, but keep this file in src/data/ so tool handlers can normalize and so you can point at it during judging as evidence of domain work.",

  "units": {
    "marla": { "sqft": 225, "urdu": "مرلہ" },
    "kanal": { "marla": 20, "sqft": 4500, "urdu": "کنال" },
    "sqft":  { "urdu": "اسکوائر فٹ" }
  },

  "money": {
    "hazaar": { "value": 1000, "urdu": "ہزار", "roman": ["hazaar", "hazar", "thousand"] },
    "lakh":   { "value": 100000, "urdu": "لاکھ", "roman": ["lakh", "lac", "lakhs"] },
    "crore":  { "value": 10000000, "urdu": "کروڑ", "roman": ["crore", "karor", "karore"] }
  },

  "modifiers": {
    "sawa":  { "op": "add",      "value": 0.25, "urdu": "سوا",    "example": "sawa 5 marla = 5.25 marla" },
    "paune": { "op": "subtract", "value": 0.25, "urdu": "پونے",   "example": "paune 2 crore = 17,500,000" },
    "dedh":  { "op": "set",      "value": 1.5,  "urdu": "ڈیڑھ",   "example": "dedh crore = 15,000,000" },
    "dhai":  { "op": "set",      "value": 2.5,  "urdu": "ڈھائی",  "example": "dhai crore = 25,000,000" },
    "sarhe": { "op": "add",      "value": 0.5,  "urdu": "ساڑھے",  "example": "sarhe teen crore = 35,000,000" },
    "adha":  { "op": "set",      "value": 0.5,  "urdu": "آدھا",   "example": "adha kanal = 10 marla" }
  },

  "numbers_urdu": {
    "1": "ایک", "2": "دو", "3": "تین", "4": "چار", "5": "پانچ",
    "6": "چھ", "7": "سات", "8": "آٹھ", "9": "نو", "10": "دس",
    "11": "گیارہ", "12": "بارہ", "13": "تیرہ", "14": "چودہ", "15": "پندرہ",
